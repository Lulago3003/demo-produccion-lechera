# Copiar a .env (ignorado por Git) y cargar con: set -a; source .env; set +a
GEMMA_MODEL=gemma3:4b
OLLAMA_URL=http://127.0.0.1:11435
GAMMA_API_URL=http://127.0.0.1:8765
MQTT_HOST=broker.ejemplo.com
MQTT_PORT=8883
MQTT_TLS=1
MQTT_FARM=mi-finca
MQTT_CLIENT_ID=gamma-mi-finca
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=

# --- Servidor con Docker (docker compose; ver DESPLIEGUE.md) ---
# Dominio con HTTPS para el dashboard con Gemma (debe apuntar a la IP del servidor)
GAMMA_DOMINIO=gemma.ejemplo.com
# Dashboards de otra página que pueden usar a Gemma, separados por comas
GAMMA_ORIGENES=https://gamma.aioros.tech
# Clave privada para enviar registros de sensores; generar con: openssl rand -hex 32
GAMMA_CLAVE=
# Carpeta con el ZIP de Gemma para no descargarlo (opcional)
GAMMA_PESOS_DIR=./pesos
